{
  "registry_db": "",
  "backends": {
    "ollama": {
      "enabled": true,
      "mode": "docker",
      "docker_container": "ollama"
    },
    "llamacpp": {
      "enabled": true,
      "model_dir": "<PATH_TO_GGUF_DIRECTORY>",
      "extensions": [".gguf"]
    },
    "comfyui": {
      "enabled": false,
      "base_dir": "M:\\Programs\\ComfyUI\\ComfyUI\\models",
      "extensions": [".safetensors", ".ckpt", ".pt", ".pth", ".bin"]
    }
  },
  "huggingface": {
    "token_env_var": "HF_TOKEN"
  },
  "civitai": {
    "token_env_var": "CIVITAI_API_KEY",
    "web_host": "civitai.green",
    "api_host": "civitai.com"
  },
  "display": {
    "date_format": "%Y-%m-%d",
    "max_name_width": 60
  },
  "mcp": {
    "host": "0.0.0.0",
    "port": 8321,
    "mode": "readonly",
    "stateful": false
  }
}
